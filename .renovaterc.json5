{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>home-operations/.github:renovate-config"],
  schedule: ["at any time"],
  customManagers: [
    {
      customType: "regex",
      description: "Process Annotations in Docker Bake",
      managerFilePatterns: ["/(^|/)docker-bake\\.hcl$/"],
      matchStrings: [
        'datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?\\n.+ = "(?<currentValue>[^"]+)"',
      ],
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}",
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}",
    },
    {
      customType: "regex",
      description: "Process Annotations in Dockerfiles",
      managerFilePatterns: ["/(^|/)Dockerfile$/"],
      matchStrings: [
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?\\n.+(:\\s|=)(&\\S+\\s)?(?<currentValue>\\S+)",
      ],
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}",
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}",
    },
  ],
  customDatasources: {
    akeyless: {
      defaultRegistryUrlTemplate: "https://akeyless-cli.s3.us-east-2.amazonaws.com/cli/latest/version",
      format: "plain",
      transformTemplates: [],
    },
  },
  packageRules: [
    {
      description: ["Release Rules for App Updates"],
      addLabels: ["app/{{parentDir}}"],
      additionalBranchPrefix: "{{parentDir}}-",
      commitMessageExtra: "( {{currentVersion}} → {{newVersion}} )",
      commitMessageTopic: "{{depName}}",
      matchFileNames: ["**/docker-bake.hcl", "**/Dockerfile"],
      semanticCommitScope: "{{parentDir}}",
      semanticCommitType: "release",
    },
    {
      description: ["Auto-merge App Updates"],
      matchFileNames: ["**/docker-bake.hcl"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
    },
    {
      description: ["Group paseo dependencies into one PR"],
      matchFileNames: ["apps/paseo/**"],
      groupName: "paseo",
      groupSlug: "paseo",
      additionalBranchPrefix: "",
    },
    {
      description: ["Wait for aqua tags to settle before alerting"],
      matchDatasources: ["github-tags"],
      matchManagers: ["mise"],
      matchDepNames: ["/^aqua:/"],
      minimumReleaseAge: "3 days",
    },
    {
      description: ["Resolve aqua tools from GitHub releases, not tags"],
      matchDatasources: ["github-tags"],
      matchManagers: ["mise"],
      matchDepNames: [
        "aqua:cilium/cilium-cli",
        "aqua:cli/cli",
        "aqua:fluxcd/flux2",
        "aqua:helmfile/helmfile",
        "aqua:mitsuhiko/minijinja",
      ],
      overrideDatasource: "github-releases",
    },
    {
      description: ["Wait for python-build-standalone to ship the prebuilt CPython"],
      matchManagers: ["mise"],
      matchDepNames: ["python"],
      minimumReleaseAge: "28 days",
    },
    {
      description: ["Normalize mise github package names"],
      matchFileNames: ["**/mise.toml", ".mise/config.toml"],
      matchDatasources: ["github-releases", "github-tags"],
      overridePackageName: "{{#if (lookup (split packageName '/') 1)}}{{packageName}}{{else if (lookup (split packageName ':') 1)}}{{ lookup (split packageName ':') 1 }}/{{ lookup (split packageName ':') 1 }}{{else}}{{packageName}}/{{packageName}}{{/if}}",
    },
    {
      description: ["Bun Debian variant only"],
      matchDatasources: ["docker"],
      matchPackageNames: ["oven/bun"],
      allowedVersions: "/-debian$/",
    },
    {
      description: ["npm app deps: wait one day"],
      matchDatasources: ["npm"],
      minimumReleaseAge: "1 day",
    },
    {
      description: [
        "Exempt App Updates from prHourlyLimit and create them last, since they still add to the hourly PR count",
      ],
      matchFileNames: ["apps/**"],
      prHourlyLimit: 0,
      prPriority: -1,
    },
  ],
}
